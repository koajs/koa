{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["http", "application", "request", "response", "search-params", "changedSince"],
  "properties": {
    "changedSince": {
      "type": "object", "additionalProperties": false, "required": ["ignore"],
      "properties": {
        "ignore": {
          "description": "Skip these paths only when no benchmark imports them. A trailing slash matches a directory.",
          "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "pullRequest"],
      "properties": {
        "full": { "$ref": "#/definitions/httpProfile" },
        "pullRequest": { "$ref": "#/definitions/httpProfile" }
      }
    },
    "application": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "oneOf": [{ "required": ["depth"] }, { "required": ["scenario"] }],
        "properties": { "scenario": { "const": "error" }, "depth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
      }
    },
    "request": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/query/items" },
          {
            "type": "object", "additionalProperties": false, "required": ["scenario"],
            "properties": { "scenario": { "enum": ["proxy and negotiation", "localized route"] } }
          }
        ]
      }
    },
    "search-params": { "$ref": "#/definitions/query" },
    "response": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "oneOf": [{ "required": ["payload"] }, { "required": ["headItems"] }, { "required": ["scenario"] }],
        "properties": { "scenario": { "enum": ["redirect", "attachment", "back", "stream"] }, "payload": { "type": "object" }, "headItems": { "$ref": "#/definitions/positive" } }
      }
    }
  },
  "definitions": {
    "component": { "enum": ["application", "request", "response", "search-params"] },
    "httpProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["warmupMs", "sampleMs"],
      "properties": {
        "warmupMs": { "$ref": "#/definitions/positive" },
        "sampleMs": { "$ref": "#/definitions/positive" }
      }
    },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "queryKind": { "enum": ["distinct", "repeated"] },
    "query": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["size", "kind"],
        "properties": { "size": { "$ref": "#/definitions/positive" }, "kind": { "$ref": "#/definitions/queryKind" } }
      }
    }
  }
}
