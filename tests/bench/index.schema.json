{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["http", "application", "request", "response", "search-params"],
  "properties": {
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "pullRequest"],
      "properties": {
        "full": { "$ref": "#/definitions/httpProfile" },
        "pullRequest": { "$ref": "#/definitions/httpProfile" }
      }
    },
    "application": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["depth"],
        "properties": { "depth": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 } }
      }
    },
    "request": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["size", "kind"],
        "properties": {
          "size": { "$ref": "#/definitions/positive" },
          "kind": { "$ref": "#/definitions/queryKind" },
          "maxRequestsPerPhase": { "$ref": "#/definitions/positive" }
        }
      }
    },
    "search-params": { "$ref": "#/definitions/query" },
    "response": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "oneOf": [{ "required": ["payload"] }, { "required": ["headItems"] }],
        "properties": { "payload": { "type": "object" }, "headItems": { "$ref": "#/definitions/positive" } }
      }
    }
  },
  "definitions": {
    "httpProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["requestsPerSecond", "connections", "warmupRequests", "latencyRequests", "capacityRequests"],
      "properties": {
        "requestsPerSecond": { "$ref": "#/definitions/positive" },
        "connections": { "$ref": "#/definitions/positive" },
        "warmupRequests": { "$ref": "#/definitions/positive" },
        "latencyRequests": { "$ref": "#/definitions/positive" },
        "capacityRequests": { "$ref": "#/definitions/positive" }
      }
    },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "queryKind": { "enum": ["distinct", "repeated"] },
    "query": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["size", "kind"],
        "properties": { "size": { "$ref": "#/definitions/positive" }, "kind": { "$ref": "#/definitions/queryKind" } }
      }
    }
  }
}
